{
  "name": "stowaway",
  "version": "0.1.0",
  "description": "E2E testing framework for React Native apps using the Hermes CDP bridge",
  "keywords": ["react-native", "e2e", "hermes", "testing", "cdp"],
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/embed-bridge.js && tsc",
    "build:watch": "tsc --watch",
    "typecheck": "node scripts/embed-bridge.js && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
