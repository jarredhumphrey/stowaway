{
  "name": "stowaway",
  "version": "0.1.1",
  "description": "E2E testing framework for React Native apps using the Hermes CDP bridge",
  "keywords": [
    "react-native",
    "e2e",
    "hermes",
    "testing",
    "cdp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarredhumphrey/stowaway.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "stowaway": "./bin/stowaway.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "node scripts/embed-bridge.js && tsup",
    "build:watch": "tsup --watch",
    "typecheck": "node scripts/embed-bridge.js && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
