{
  "name": "stowaway-example",
  "version": "0.1.0",
  "description": "Sandbox app for developing and testing stowaway",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "e2e:ios": "PLATFORM=ios BUNDLE_ID=com.stowaway.example tsx e2e/run.ts",
    "e2e:android": "PLATFORM=android BUNDLE_ID=com.stowaway.example tsx e2e/run.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-keep-awake": "~14.0.3",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "~18.3.12",
    "stowaway": "file:../",
    "tsx": "^4.21.0",
    "typescript": "~5.3.3"
  }
}
